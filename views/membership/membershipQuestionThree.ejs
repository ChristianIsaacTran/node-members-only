<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Question 3</title>
    <link rel="stylesheet" href="/membership.css" />
  </head>
  <body>
    <% if(memberResult) { %> 
       <%- include("./membershipStatus") %>
    <% } else {%>
        <div class="troll-dialogue">
            <p>Troll: Question 3: What is the membership password?</p>
        </div>
    <% } %>
    <div class="user-dialogue">
      <form action="/membership" method="post">
        <div class="input-group">
            <label for="memberPass">Member Password:</label>
            <input type="password" name="memberPass" id="memberPass" placeholder="What is the password?" autocomplete="off">
            <button type="submit">Submit</button>
        </div>
      </form>
        <a href="/">Back to home</a>
    </div>
  </body>
</html>
